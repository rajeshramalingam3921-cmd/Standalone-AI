# Copy to .env (repository root) and adjust. Never commit .env.
# Variables already set in the environment take precedence over this file.

# production = HTTPS-only session cookie (still works on http://127.0.0.1 / localhost
# in current browsers) and the server serves the built web UI. Leave unset for development.
# NODE_ENV=production

# --- Network -------------------------------------------------------------
# Server binds to loopback by default. To reach it from your iPhone, use a
# private network (e.g. a VPN/tailnet) — never expose it directly to the internet.
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
# Set to "true" only if you deliberately bind HOST to a non-loopback address
# on a private network you control.
ALLOW_NON_LOOPBACK=false
# Host names the server answers to (DNS-rebinding guard). Add your private VPN name if needed.
# ALLOWED_HOSTS=127.0.0.1,localhost,::1
# Trust X-Forwarded-* only from a proxy on this machine (e.g. Tailscale Serve). See docs/IPHONE-ACCESS.md.
# TRUST_PROXY=false
# Serve the built web UI from this server: auto | true | false
# SERVE_WEB=auto

# --- Data ----------------------------------------------------------------
# PostgreSQL (recommended). When unset, data is kept in a JSON file in DATA_DIR.
# DATABASE_URL=postgresql://thiran:CHANGE_ME@127.0.0.1:5432/thiran_dev
# DATA_DIR=.thiran-data
# Where `pnpm backup` writes. Relative paths are relative to apps/server. Copy it off-machine.
# BACKUP_DIR=.thiran-backups

# --- Sign-in -------------------------------------------------------------
# Session lifetime in days (1–90).
# SESSION_TTL_DAYS=30
# Send the session cookie only over HTTPS: auto (= true in production) | true | false
# COOKIE_SECURE=auto
# Login attempts allowed per client per 15 minutes.
# LOGIN_RATE_LIMIT_MAX=5
# General API requests per client per minute.
# RATE_LIMIT_PER_MINUTE=300

# --- Project folders and commands (Phase 6) ------------------------------
# Comma-separated absolute folders that project folders must live INSIDE.
# Empty = no project can read files or run commands. Example (Windows):
# WORKSPACE_ROOTS=C:\Users\you\code
# WORKSPACE_ROOTS=
# Build/test/lint commands are killed after this long; output kept (characters).
# COMMAND_TIMEOUT_MS=600000
# COMMAND_OUTPUT_MAX=64000

# --- AI agent (Phase 6b) -------------------------------------------------
# Execution attempts and plans per task, model turns, tokens and time per agent run.
# AGENT_MAX_ATTEMPTS=3
# AGENT_MAX_PLANS=10
# AGENT_MAX_TURNS=30
# AGENT_TOKEN_BUDGET=1500000
# AGENT_TIMEOUT_MS=1200000

# --- AI (Phase 5) ----------------------------------------------------------
# anthropic = real Claude API (needs ANTHROPIC_API_KEY) | mock = offline test replies
# AI_PROVIDER=anthropic
# API key from console.anthropic.com. A Claude Pro/Max subscription does NOT include API access.
# Stays on the server: never sent to the browser, never logged.
# ANTHROPIC_API_KEY=
# Selectable models (comma-separated) and the default for new conversations.
# AI_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5
# AI_DEFAULT_MODEL=claude-opus-5-5
# Reasoning effort: low | medium | high | xhigh | max (higher = better answers, more tokens)
# AI_EFFORT=high
# AI_MAX_TOKENS=32000
# AI_TIMEOUT_MS=600000
# Chat messages per client per minute, and how many recent messages are sent as context.
# AI_RATE_LIMIT_PER_MINUTE=20
# AI_HISTORY_MESSAGES=40
