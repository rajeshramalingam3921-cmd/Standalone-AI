# Copy to .env and adjust. Never commit .env.
# Server binds to loopback by default. To reach it from your iPhone, use a
# private network (e.g. a VPN/tailnet) — never expose it directly to the internet.
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
# Set to "true" only if you deliberately bind HOST to a non-loopback address
# on a private network you control.
ALLOW_NON_LOOPBACK=false

# AI provider keys (Phase 5). Leave empty until needed.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Database (Phase 4)
# DATABASE_URL=postgresql://thiran:CHANGE_ME@127.0.0.1:5432/thiran_dev

# Where projects/tasks are stored (Phase 3: JSON file). Back this folder up.
# DATA_DIR=.thiran-data
# Host names the server answers to (DNS-rebinding guard). Add your private VPN name if needed.
# ALLOWED_HOSTS=127.0.0.1,localhost,::1
