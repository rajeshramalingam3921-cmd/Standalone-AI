# Copy to .env (repository root) and adjust. Never commit .env.
# Variables already set in the environment take precedence over this file.

# --- Network -------------------------------------------------------------
# Server binds to loopback by default. To reach it from your iPhone, use a
# private network (e.g. a VPN/tailnet) — never expose it directly to the internet.
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
# Set to "true" only if you deliberately bind HOST to a non-loopback address
# on a private network you control.
ALLOW_NON_LOOPBACK=false
# Host names the server answers to (DNS-rebinding guard). Add your private VPN name if needed.
# ALLOWED_HOSTS=127.0.0.1,localhost,::1

# --- Data ----------------------------------------------------------------
# PostgreSQL (recommended). When unset, data is kept in a JSON file in DATA_DIR.
# DATABASE_URL=postgresql://thiran:CHANGE_ME@127.0.0.1:5432/thiran_dev
# DATA_DIR=.thiran-data

# --- Sign-in -------------------------------------------------------------
# Session lifetime in days (1–90).
# SESSION_TTL_DAYS=30
# Send the session cookie only over HTTPS: auto (= true in production) | true | false
# COOKIE_SECURE=auto
# Login attempts allowed per client per 15 minutes.
# LOGIN_RATE_LIMIT_MAX=5
# General API requests per client per minute.
# RATE_LIMIT_PER_MINUTE=300

# --- AI providers (Phase 5) ----------------------------------------------
# ANTHROPIC_API_KEY=
