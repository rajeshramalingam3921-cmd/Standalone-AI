{
  "name": "thiran-ai",
  "private": true,
  "version": "0.1.0",
  "description": "Thiran AI (திறன் AI) — personal, security-first AI development platform",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build:shared": "pnpm --filter @thiran/shared build",
    "build": "pnpm -r build",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build:shared && pnpm -r test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev:server": "pnpm build:shared && pnpm --filter @thiran/server dev",
    "dev:web": "pnpm --filter @thiran/web dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  }
}
